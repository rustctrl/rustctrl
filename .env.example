# Copy to .env and set these before initializing PKI for an office host.
# The loopback default is intended for a local bootstrap smoke test.
RUSTCTRL_LISTEN_ADDRESS=127.0.0.1
RUSTCTRL_PORT=9876
RUSTCTRL_SERVER_NAME=localhost
RUSTCTRL_SERVER_IP=127.0.0.1
RUSTCTRL_SERVER_ENDPOINT=https://localhost:9876
